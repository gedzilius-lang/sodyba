# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- registry
SR_REFRESH_HOUR=4
SR_REFRESH_ON_BOOT=true
SR_REQUEST_DELAY=1.0
SR_USER_AGENT=sodyba-radar/1.0 (private research; you@example.com)

# ---------------------------------------------------------------- mailbox
# Dedicated mailbox that receives portal alert emails. Leave blank to disable
# automatic ingestion (the app still works; you add listings by hand).
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# The account login password will NOT work over IMAP.
SR_IMAP_HOST=imap.gmail.com
SR_IMAP_PORT=993
SR_IMAP_USER=sodyba.alerts@gmail.com
SR_IMAP_PASSWORD=xxxx-xxxx-xxxx-xxxx
SR_IMAP_FOLDER=INBOX
SR_IMAP_MAX_PER_RUN=40
SR_IMAP_MARK_SEEN=true
SR_MAILBOX_POLL_MINUTES=15

# ---------------------------------------------------------------- notify
# Telegram push when a listing clears a filter profile. Optional but useful:
# auction lots move fast and a 15-minute poll only helps if it reaches a phone.
SR_TELEGRAM_TOKEN=
SR_TELEGRAM_CHAT_ID=
